{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CloudSpaceLab/ai-logfixer/contracts/v1/schemas/external-ref.schema.json",
  "title": "ExternalRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "type", "id", "url", "metadata"],
  "properties": {
    "system": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "url": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
