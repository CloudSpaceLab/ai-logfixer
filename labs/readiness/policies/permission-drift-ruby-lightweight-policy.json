{
  "lane": "permission-drift",
  "allowed_paths": [
    "storage"
  ],
  "permission_targets": [
    {
      "path": "storage",
      "kind": "dir",
      "access": "write",
      "expected_mode": "0775"
    },
    {
      "path": "public/status.txt",
      "kind": "file",
      "access": "read",
      "expected_mode": "0644"
    },
    {
      "path": "storage/audit.log",
      "kind": "file",
      "access": "write",
      "expected_mode": "0664"
    }
  ],
  "expected_owner": "app",
  "expected_group": "app",
  "expected_mode": "0775",
  "forbidden_actions": [
    "chmod_777",
    "recursive_root_change_outside_allowlist"
  ],
  "verification": {
    "method": "http",
    "url": "http://127.0.0.1:18088/orders/readiness",
    "expected_status": 200,
    "body_contains": "FIXED"
  }
}
