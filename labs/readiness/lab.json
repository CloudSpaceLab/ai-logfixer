{
  "version": "v1",
  "name": "AI LogFixer production readiness lab",
  "docker_compose": "docker-compose.yml",
  "expected_current_state": "failing until a production resolver can repair every scenario",
  "required_scenarios": [
    "php-laravel",
    "python-fastapi",
    "python-django",
    "node-express",
    "ruby-rails"
  ],
  "scenarios": [
    {
      "id": "php-laravel",
      "service_name": "readiness-php-laravel",
      "language": "php",
      "framework": "laravel",
      "app_dir": "apps/php-laravel",
      "message": "database unavailable",
      "docker_service": "php-laravel",
      "expected_owner_suffix": "app/Http/Controllers/OrderController.php",
      "container_app_dir": "/app",
      "live_probe_url": "http://127.0.0.1:18081/orders/readiness",
      "expected_broken_status": 500,
      "expected_fixed_status": 200,
      "fixed_body_contains": "FIXED",
      "faults": [
        {
          "id": "controller-runtime-error",
          "description": "Order controller throws a runtime error while handling a request.",
          "mode": "runtime_error"
        },
        {
          "id": "db-config-error",
          "description": "Application cannot connect to the configured database.",
          "mode": "db_config_error"
        }
      ]
    },
    {
      "id": "python-fastapi",
      "service_name": "readiness-python-fastapi",
      "language": "python",
      "framework": "fastapi",
      "app_dir": "apps/python-fastapi",
      "message": "database unavailable",
      "docker_service": "python-fastapi",
      "expected_owner_suffix": "app/main.py",
      "container_app_dir": "/app",
      "live_probe_url": "http://127.0.0.1:18082/orders/readiness",
      "expected_broken_status": 500,
      "expected_fixed_status": 200,
      "fixed_body_contains": "FIXED",
      "faults": [
        {
          "id": "endpoint-runtime-error",
          "description": "FastAPI endpoint raises a runtime error.",
          "mode": "runtime_error"
        },
        {
          "id": "settings-error",
          "description": "FastAPI service receives an invalid database URL.",
          "mode": "settings_error"
        }
      ]
    },
    {
      "id": "python-django",
      "service_name": "readiness-python-django",
      "language": "python",
      "framework": "django",
      "app_dir": "apps/python-django",
      "message": "database unavailable",
      "docker_service": "python-django",
      "expected_owner_suffix": "orders/views.py",
      "container_app_dir": "/app",
      "live_probe_url": "http://127.0.0.1:18083/orders/readiness",
      "expected_broken_status": 500,
      "expected_fixed_status": 200,
      "fixed_body_contains": "FIXED",
      "faults": [
        {
          "id": "view-runtime-error",
          "description": "Django view raises a runtime error while handling a request.",
          "mode": "runtime_error"
        },
        {
          "id": "database-url-error",
          "description": "Django service receives an invalid database URL.",
          "mode": "database_url_error"
        }
      ]
    },
    {
      "id": "node-express",
      "service_name": "readiness-node-express",
      "language": "node",
      "framework": "express",
      "app_dir": "apps/node-express",
      "message": "database unavailable",
      "docker_service": "node-express",
      "expected_owner_suffix": "src/server.js",
      "container_app_dir": "/app",
      "live_probe_url": "http://127.0.0.1:18084/orders/readiness",
      "expected_broken_status": 500,
      "expected_fixed_status": 200,
      "fixed_body_contains": "FIXED",
      "faults": [
        {
          "id": "route-runtime-error",
          "description": "Express route throws a runtime error.",
          "mode": "runtime_error"
        },
        {
          "id": "dependency-config-error",
          "description": "Express service receives an invalid database URL.",
          "mode": "dependency_config_error"
        }
      ]
    },
    {
      "id": "ruby-rails",
      "service_name": "readiness-ruby-rails",
      "language": "ruby",
      "framework": "rails",
      "app_dir": "apps/ruby-rails",
      "message": "database unavailable",
      "docker_service": "ruby-rails",
      "expected_owner_suffix": "app/controllers/orders_controller.rb",
      "container_app_dir": "/app",
      "live_probe_url": "http://127.0.0.1:18085/orders/readiness",
      "expected_broken_status": 500,
      "expected_fixed_status": 200,
      "fixed_body_contains": "FIXED",
      "faults": [
        {
          "id": "controller-runtime-error",
          "description": "Rails controller raises a runtime error.",
          "mode": "runtime_error"
        },
        {
          "id": "active-record-error",
          "description": "Rails action fails while resolving database state.",
          "mode": "active_record_error"
        }
      ]
    }
  ]
}
